# ==========================================
# KONFIGURASI API KEY (Autonomous Screening Platform)
# ==========================================

# 1. Google Gemini API (Direkomendasikan untuk reasoning LLM)
# Dapatkan API Key gratis di: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# 2. OpenAI API (Opsional / Alternatif)
# Dapatkan di: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# 3. Model LLM yang digunakan (Default: gemini-1.5-flash)
LLM_PROVIDER=gemini
LLM_MODEL_NAME=gemini-1.5-flash
